    getline(cin, city);
    
    cout << "Введите год основания клуба: ";
    foundationYear = safeInt();
    
    // СОЗДАНИЕ КЛУБА - НАЧАЛО КОМПОЗИЦИИ
    // Клуб создаётся с введёнными пользователем параметрами
    HockeyClub club(clubName, city, foundationYear);
    
    int choice;
    
    do {
        showMainMenu();
        cin >> choice;
        
        switch(choice)
        {
            case 1:
            {
                // Добавление игрока через консоль
                string name, team;
                int age, number, position;
                int salary = 5000;
                double contractTerm = 1.5;
                
                clearInput();
                
                cout << "\n=== ДОБАВЛЕНИЕ НОВОГО ИГРОКА ===" << endl;
                cout << "Введите ФИО игрока: ";
                getline(cin, name);
                
                cout << "Введите название команды игрока: ";
                getline(cin, team);
                
                // Проверка возраста
                bool validAge = false;
                do {
                    cout << "Введите возраст игрока (18-55): ";
                    cin >> age;
                    if (age >= 18 && age <= 55)
                    {
                        validAge = true;
                    }
                    else
                    {
                        cout << "Ошибка! Возраст должен быть от 18 до 55 лет" << endl;
                        clearInput();
                    }
                } while (!validAge);
                
                // Проверка номера
                bool validNumber = false;
                do {
                    cout << "Введите желаемый номер игрока (1-99): ";
                    cin >> number;
                    
                    if (number < 1 || number > 99)
                    {
                        cout << "Номер должен быть в диапазоне от 1 до 99!" << endl;
                    }
                    else
                    {
                        validNumber = true;
                    }
                } while (!validNumber);
                
                // Выбор позиции
                cout << "\n--- ВЫБОР ПОЗИЦИИ ---" << endl;
                cout << "1. Вратарь" << endl;
                cout << "2. Защитник" << endl;
                cout << "3. Нападающий" << endl;
                cout << "Выберите позицию (1-3): ";
                cin >> position;
                
                club.createAndAddPlayer(name, team, age, number, salary, contractTerm, position);
                break;
            }
            case 2:
                club.showAllPlayers();
                break;
            case 3:
                club.showPlayersByPosition();
                break;
            case 4:
            {
                if (club.getTotalPlayers() == 0)
                {
                    cout << "\nВ клубе нет игроков для удаления!" << endl;
                }
                else
                {
                    clearInput();
                    cout << "\n=== УДАЛЕНИЕ ИГРОКА ===" << endl;
                    cout << "Введите ФИО игрока, которого хотите удалить: ";
                    string name;
                    getline(cin, name);
                    club.removePlayerByName(name);
                }
                break;
            }
            case 5:
                club.showClubInfo();
                break;
            case 6:
                club.showAvailableNumbersInClub();
                break;
            case 7:
                cout << "\n До свидания!" << endl;
                break;
            default:
                cout << "\n Неверный выбор!" << endl;
        }
    } while (choice != 7);
    
    // При выходе из main клуб уничтожается, а вместе с ним и все игроки (композиция!)
    cout << "\nЗавершение работы программы..." << endl;
    
    return 0;
}
