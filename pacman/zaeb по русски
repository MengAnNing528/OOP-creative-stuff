class MyButton {
public:
    int x, y, w, h;
    COLORREF normal, hover, click;
    const char* text;
    void (*action)();
    bool clicked;
    
    MyButton(int _x, int _y, int _w, int _h, const char* _t, COLORREF _n, COLORREF _hv, COLORREF _c, void (*a)()) {
        x = _x; y = _y; w = _w; h = _h; text = _t; normal = _n; hover = _hv; click = _c; action = a; clicked = false;
    }
    
    void Draw(HDC dc, bool over) {
        COLORREF col = over ? (clicked ? click : hover) : normal;
        HBRUSH br = CreateSolidBrush(col);
        HPEN pen = CreatePen(PS_SOLID, 2, BORDER_COLOR);
        SelectObject(dc, br);
        SelectObject(dc, pen);
        Rectangle(dc, x, y, x + w, y + h);
        DeleteObject(br);
        DeleteObject(pen);
        SetBkMode(dc, TRANSPARENT);
        SetTextColor(dc, RGB(255,255,200));
        HFONT font = CreateFont(18,0,0,0,FW_BOLD,0,0,0,DEFAULT_CHARSET,0,0,0,0,"Segoe UI");
        SelectObject(dc, font);
        SIZE sz;
        GetTextExtentPoint32A(dc, text, (int)strlen(text), &sz);
        TextOutA(dc, x + (w - sz.cx)/2, y + (h - sz.cy)/2, text, (int)strlen(text));
        DeleteObject(font);
    }
    
    bool Check(int mx, int my) {
        if(mx >= x && mx <= x+w && my >= y && my <= y+h) {
            if(action) action();
            return true;
        }
        return false;
    }
};

