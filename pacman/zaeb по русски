    DeleteObject(font);
}

LRESULT CALLBACK WndProc(HWND hWnd, UINT msg, WPARAM wp, LPARAM lp) {
    switch(msg) {
        case WM_CREATE: {
            btns[btnCount++] = new MyButton(50, 150, 180, 45, "Анна", RGB(60,60,80), RGB(80,80,110), RGB(100,100,140), ShowAnna);
            btns[btnCount++] = new MyButton(250, 150, 180, 45, "Дарья", RGB(60,60,80), RGB(80,80,110), RGB(100,100,140), ShowDaria);
            btns[btnCount++] = new MyButton(450, 150, 180, 45, "Виктория", RGB(60,60,80), RGB(80,80,110), RGB(100,100,140), ShowVictoria);
            btns[btnCount++] = new MyButton(50, 310, 180, 45, "Попов А.А.", RGB(139,0,0), RGB(180,0,0), RGB(100,100,140), ShowPopov);
            btns[btnCount++] = new MyButton(250, 310, 180, 45, "Алейников В.В.", RGB(139,0,0), RGB(180,0,0), RGB(100,100,140), ShowAleynikov);
            btns[btnCount++] = new MyButton(450, 310, 180, 45, "Корнеев Д.Г.", RGB(139,0,0), RGB(180,0,0), RGB(100,100,140), ShowKorneev);
            btns[btnCount++] = new MyButton(50, 470, 130, 40, "ОПЦИИ", RGB(50,80,100), RGB(80,80,110), RGB(100,100,140), ShowOptions);
            btns[btnCount++] = new MyButton(200, 470, 130, 40, "СБЕЖАТЬ", RGB(100,50,50), RGB(180,0,0), RGB(100,100,140), EscapeGame);
            btns[btnCount++] = new MyButton(680, 470, 200, 50, "СТАРТ PACMAN", RGB(0,100,0), RGB(0,150,0), RGB(0,200,0), StartPacman);
            break;
        }
        case WM_PAINT: {
            PAINTSTRUCT ps;
            HDC dc = BeginPaint(hWnd, &ps);
            HBRUSH bg = CreateSolidBrush(BG_COLOR);
            FillRect(dc, &ps.rcPaint, bg);
            DeleteObject(bg);
            DrawText(dc, 350, 20, "СЕССИЯ", 70, TITLE_COLOR);
            DrawText(dc, 50, 110, "ВЫБЕРИТЕ УЧАСТНИКА", 22, TEXT_COLOR);
            DrawText(dc, 50, 270, "ВЫБЕРИТЕ БОССА", 22, TEXT_COLOR);
            POINT pt;
            GetCursorPos(&pt);
            ScreenToClient(hWnd, &pt);
            for(int i = 0; i < btnCount; i++) {
                bool over = (pt.x >= btns[i]->x && pt.x <= btns[i]->x + btns[i]->w && pt.y >= btns[i]->y && pt.y <= btns[i]->y + btns[i]->h);
                btns[i]->Draw(dc, over);
            }
            HBRUSH panel = CreateSolidBrush(PANEL_COLOR);
            HPEN border = CreatePen(PS_SOLID, 2, BORDER_COLOR);
            SelectObject(dc, panel);
            SelectObject(dc, border);
            Rectangle(dc, 650, 110, 880, 500);
            DeleteObject(panel);
            DeleteObject(border);
            if(showInfo && strlen(currentInfo) > 0) {
                HFONT font = CreateFont(16,0,0,0,FW_NORMAL,0,0,0,DEFAULT_CHARSET,0,0,0,0,"Segoe UI");
                SelectObject(dc, font);
                SetTextColor(dc, TEXT_COLOR);
                std::string txt = currentInfo;
                size_t p = 0;
                int lineY = 140;
                while((p = txt.find('\n')) != std::string::npos) {
                    std::string line = txt.substr(0, p);
                    TextOutA(dc, 670, lineY, line.c_str(), (int)line.length());
                    lineY += 28;
                    txt.erase(0, p+1);
                }
                TextOutA(dc, 670, lineY, txt.c_str(), (int)txt.length());
                DeleteObject(font);
            }
            DrawText(dc, 700, 530, "Copyright MoJang AB", 12, RGB(80,80,100));
            EndPaint(hWnd, &ps);
            break;
        }
        case WM_LBUTTONDOWN: {
            POINT pt;
            GetCursorPos(&pt);
            ScreenToClient(hWnd, &pt);
            for(int i = 0; i < btnCount; i++) {
                if(pt.x >= btns[i]->x && pt.x <= btns[i]->x + btns[i]->w && pt.y >= btns[i]->y && pt.y <= btns[i]->y + btns[i]->h) {
                    btns[i]->clicked = true;
                    InvalidateRect(hWnd, NULL, TRUE);
                    break;
                }
            }
            break;
        }
        case WM_LBUTTONUP: {
            POINT pt;
            GetCursorPos(&pt);
            ScreenToClient(hWnd, &pt);
            for(int i = 0; i < btnCount; i++) {
                if(pt.x >= btns[i]->x && pt.x <= btns[i]->x + btns[i]->w && pt.y >= btns[i]->y && pt.y <= btns[i]->y + btns[i]->h) {
                    btns[i]->Check(pt.x, pt.y);
                }
                btns[i]->clicked = false;
            }
            InvalidateRect(hWnd, NULL, TRUE);
            break;
        }
        case WM_MOUSEMOVE:
            InvalidateRect(hWnd, NULL, TRUE);
            break;
        case WM_DESTROY:
            for(int i = 0; i < btnCount; i++) delete btns[i];
            PostQuitMessage(0);
            break;
        default:
            return DefWindowProc(hWnd, msg, wp, lp);
    }
    return 0;
}

int WINAPI WinMain(HINSTANCE hInst, HINSTANCE hPrev, LPSTR cmd, int show) {
    srand((unsigned int)time(NULL));
    WNDCLASSEX wc = {};
    wc.cbSize = sizeof(WNDCLASSEX);
    wc.style = CS_HREDRAW | CS_VREDRAW;
    wc.lpfnWndProc = WndProc;
    wc.hInstance = hInst;
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = CreateSolidBrush(BG_COLOR);
    wc.lpszClassName = "MyGame";
    RegisterClassEx(&wc);
    
    mainWnd = CreateWindowEx(0, "MyGame", "Сессия - Игра", WS_OVERLAPPEDWINDOW | WS_VISIBLE,
        CW_USEDEFAULT, 0, 920, 600, NULL, NULL, hInst, NULL);
    
    if(!mainWnd) return FALSE;
    ShowWindow(mainWnd, show);
    UpdateWindow(mainWnd);
    
    MSG msg;
    while(GetMessage(&msg, NULL, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }
    return msg.wParam;
}
