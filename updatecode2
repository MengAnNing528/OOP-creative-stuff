int main()
{
    int choice;
    
    do {
        cout << "\n=======================================================" << endl;
        cout << "           ХОККЕЙНЫЙ КЛУБ - ГЛАВНОЕ МЕНЮ              " << endl;
        cout << "=======================================================" << endl;
        cout << " 1. Добавить игрока                                   " << endl;
        cout << " 2. Показать всех игроков                             " << endl;
        cout << " 3. Показать игроков по амплуа (ввод с консоли)       " << endl;
        cout << " 4. Удалить игрока                                    " << endl;
        cout << " 5. Выйти                                             " << endl;
        cout << "=======================================================" << endl;
        cout << "Ваш выбор: ";
        cin >> choice;
        
        switch(choice)
        {
            case 1:
                Add_Player();
                break;
            case 2:
                ShowAllPlayers();
                break;
            case 3:
                ShowPlayersByPosition();
                break;
            case 4:
                DeletePlayerByName();
                break;
            case 5:
                cout << "\n До свидания!" << endl;
                break;
            default:
                cout << "\n Неверный выбор!" << endl;
        }
    } while (choice != 5);
    
    return 0;
}
