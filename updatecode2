//=================================================
// Функция для проверки, занят ли номер
//=================================================
bool isNumberTaken(int number)
{
    // Проверяем среди вратарей
    for (int i = 0; i < allGoalies.size(); i++)
    {
        if (allGoalies[i].getPlayerNumber() == number)
            return true;
    }
    
    // Проверяем среди защитников
    for (int i = 0; i < allDefenders.size(); i++)
    {
        if (allDefenders[i].getPlayerNumber() == number)
            return true;
    }
    
    // Проверяем среди нападающих
    for (int i = 0; i < allForwards.size(); i++)
    {
        if (allForwards[i].getPlayerNumber() == number)
            return true;
    }
    
    return false;
}

//=================================================
// Функция для показа доступных номеров
//=================================================
void showAvailableNumbers()
{
    cout << "Свободные номера: ";
    int count = 0;
    for (int num = 1; num <= 99; num++)
    {
        if (!isNumberTaken(num))
        {
            cout << num << " ";
            count++;
        }
    }
    if (count == 0)
    {
        cout << "Нет свободных номеров";
    }
    cout << endl;
}

