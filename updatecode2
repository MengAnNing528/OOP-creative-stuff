//=================================================
// Функция для вывода игроков по заданному амплуа
//=================================================
void ShowPlayersByPosition()
{
    cout << "\n=== ВЫБОР АМПЛУА ===" << endl;
    cout << "Введите амплуа (вратарь, защитник, нападающий): ";
    
    clearInput();
    string position;
    getline(cin, position);
    
    // Приводим строку к нижнему регистру для сравнения
    for (int i = 0; i < position.length(); i++)
    {
        position[i] = tolower(position[i]);
    }
    
    if (position == "вратарь" || position == "вратари" || position == "goalie" || position == "goalies")
    {
        ShowGoalies();
    }
    else if (position == "защитник" || position == "защитники" || position == "defender" || position == "defenders")
    {
        ShowDefenders();
    }
    else if (position == "нападающий" || position == "нападающие" || position == "forward" || position == "forwards")
    {
        ShowForwards();
    }
    else
    {
        cout << "\n Ошибка! Неизвестное амплуа: " << position << endl;
        cout << "Доступные амплуа: вратарь, защитник, нападающий" << endl;
    }
}

