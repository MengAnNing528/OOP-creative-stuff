//=================================================
// Функция для добавления игрока
//=================================================
void Add_Player() 
{
    string name, team;
    int age, number;
    int salary = 5000;
    double contractTerm = 1.5;

    clearInput();
    
    cout << "\n=== ДОБАВЛЕНИЕ НОВОГО ИГРОКА ===" << endl;
    cout << "Введите ФИО игрока: ";
    getline(cin, name);
    
    cout << "Введите название команды игрока: ";
    getline(cin, team);
    
    // Проверка возраста
    bool validAge = false;
    do {
        cout << "Введите возраст игрока (18-55): ";
        cin >> age;
        if (age >= 18 && age <= 55)
        {
            validAge = true;
        }
        else
        {
            cout << "Ошибка! Возраст должен быть от 18 до 55 лет" << endl;
            clearInput();
        }
    } while (!validAge);
    
    // Проверка номера
    bool validNumber = false;
    do {
        cout << "Введите желаемый номер игрока (1-99): ";
        cin >> number;
        
        if (number < 1 || number > 99)
        {
            cout << "Номер должен быть в диапазоне от 1 до 99!" << endl;
        }
        else if (isNumberTaken(number))
        {
            cout << "Номер " << number << " уже занят!" << endl;
            showAvailableNumbers();
        }
        else
        {
            validNumber = true;
        }
    } while (!validNumber);
    
    // Выбор позиции
    cout << "\n--- ВЫБОР ПОЗИЦИИ ---" << endl;
    cout << "1. Вратарь" << endl;
    cout << "2. Защитник" << endl;
    cout << "3. Нападающий" << endl;
    cout << "Выберите позицию (1-3): ";
    int posChoice;
    cin >> posChoice;
    
    // Создаём игрока в зависимости от выбранной позиции
    if (posChoice == 1) 
    {
        Goalie newPlayer(name, team, age, number, salary, contractTerm);
        allGoalies.push_back(newPlayer);
        cout << "\n ВРАТАРЬ УСПЕШНО ДОБАВЛЕН!" << endl;
    }
    else if (posChoice == 2) 
    {
        Defender newPlayer(name, team, age, number, salary, contractTerm);
        allDefenders.push_back(newPlayer);
        cout << "\n ЗАЩИТНИК УСПЕШНО ДОБАВЛЕН!" << endl;
    }
    else if (posChoice == 3) 
    {
        Forward newPlayer(name, team, age, number, salary, contractTerm);
        allForwards.push_back(newPlayer);
        cout << "\n НАПАДАЮЩИЙ УСПЕШНО ДОБАВЛЕН!" << endl;
    }
    else
    {
        cout << "Неверный выбор позиции! Игрок не будет добавлен." << endl;
        return;
    }

    cout << "\n====================================" << endl;
    cout << "Информация об игроке:" << endl;
    cout << "  ФИО: " << name << endl;
    cout << "  Возраст: " << age << " лет" << endl;
    cout << "  Номер: " << number << endl;
    cout << "  Команда: " << team << endl;
    cout << "====================================" << endl;
    
    int total = allGoalies.size() + allDefenders.size() + allForwards.size();
    cout << "Всего игроков в системе: " << total << endl;
}

//=================================================
// Функция для удаления игрока по имени
//=================================================
void DeletePlayerByName()
{
    int total = allGoalies.size() + allDefenders.size() + allForwards.size();
    
    if (total == 0)
    {
        cout << "\nСписок игроков пуст! Некого удалять." << endl;
        return;
    }
    
    cout << "\n=== УДАЛЕНИЕ ИГРОКА ===" << endl;
    cout << "Введите ФИО игрока, которого хотите удалить: ";
    clearInput();
    string name;
    getline(cin, name);
    
    bool found = false;
    
    // Поиск среди вратарей
    for (int i = 0; i < allGoalies.size(); i++)
    {
        if (allGoalies[i].getPlayerName() == name)
        {
            cout << "\nНайден игрок (ВРАТАРЬ):" << endl;
            cout << "  ФИО: " << allGoalies[i].getPlayerName() << endl;
            cout << "  Команда: " << allGoalies[i].getPlayerTeam() << endl;
            cout << "  Возраст: " << allGoalies[i].getPlayerAge() << endl;
            cout << "  Номер: " << allGoalies[i].getPlayerNumber() << endl;
            
            cout << "\nВы уверены, что хотите удалить этого игрока? (y/n): ";
            char confirm;
            cin >> confirm;
            
            if (confirm == 'y' || confirm == 'Y')
            {
                allGoalies.erase(allGoalies.begin() + i);
                cout << " Игрок успешно удалён!" << endl;
            }
            else
            {
                cout << " Удаление отменено." << endl;
            }
            found = true;
            break;
        }
    }
    
    // Если не нашли среди вратарей, ищем среди защитников
    if (!found)
    {
        for (int i = 0; i < allDefenders.size(); i++)
        {
            if (allDefenders[i].getPlayerName() == name)
            {
                cout << "\nНайден игрок (ЗАЩИТНИК):" << endl;
                cout << "  ФИО: " << allDefenders[i].getPlayerName() << endl;
                cout << "  Команда: " << allDefenders[i].getPlayerTeam() << endl;
                cout << "  Возраст: " << allDefenders[i].getPlayerAge() << endl;
                cout << "  Номер: " << allDefenders[i].getPlayerNumber() << endl;
                
                cout << "\nВы уверены, что хотите удалить этого игрока? (y/n): ";
                char confirm;
                cin >> confirm;
                
                if (confirm == 'y' || confirm == 'Y')
                {
                    allDefenders.erase(allDefenders.begin() + i);
                    cout << " Игрок успешно удалён!" << endl;
                }
                else
                {
                    cout << " Удаление отменено." << endl;
                }
                found = true;
                break;
            }
        }
    }
    
    // Если не нашли среди защитников, ищем среди нападающих
    if (!found)
    {
        for (int i = 0; i < allForwards.size(); i++)
        {
            if (allForwards[i].getPlayerName() == name)
            {
                cout << "\nНайден игрок (НАПАДАЮЩИЙ):" << endl;
                cout << "  ФИО: " << allForwards[i].getPlayerName() << endl;
                cout << "  Команда: " << allForwards[i].getPlayerTeam() << endl;
                cout << "  Возраст: " << allForwards[i].getPlayerAge() << endl;
                cout << "  Номер: " << allForwards[i].getPlayerNumber() << endl;
                
                cout << "\nВы уверены, что хотите удалить этого игрока? (y/n): ";
                char confirm;
                cin >> confirm;
                
                if (confirm == 'y' || confirm == 'Y')
                {
                    allForwards.erase(allForwards.begin() + i);
                    cout << " Игрок успешно удалён!" << endl;
                }
                else
                {
                    cout << " Удаление отменено." << endl;
                }
                found = true;
                break;
            }
        }
    }
    
    if (!found)
    {
        cout << " Игрок с именем \"" << name << "\" не найден!" << endl;
    }
}

