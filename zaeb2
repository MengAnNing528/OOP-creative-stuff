// Функция для отображения информации о выбранном боссе
void ShowBossInfo()
{
    if (selectedBoss.name.empty())
    {
        MessageBoxW(NULL, L"Вы ещё не выбрали босса!", L"Предупреждение", MB_OK | MB_ICONWARNING);
        return;
    }
    
    wstring message = L"Выбран босс: " + selectedBoss.name + L"\n";
    message += L"Испытание: " + selectedBoss.title + L"\n";
    message += L"Описание: " + selectedBoss.description;
    
    MessageBoxW(NULL, message.c_str(), L"Информация о боссе", MB_OK | MB_ICONINFORMATION);
}

// Диалоговое окно выбора босса
